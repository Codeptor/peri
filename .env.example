# Copy to .env and fill in. `chmod 600 .env`. Never commit it.
#
# The .env FILE WINS over an inherited shell variable. That inversion is
# deliberate: a stale `export ANALYST_MODEL=...` left in a shell once silently
# overrode the file and cost a day of debugging.

# ---------------------------------------------------------------- Hyperliquid
# The main wallet that holds the money. Orders are signed by a separate agent
# key that CANNOT withdraw, so this address is not itself a secret.
HL_ACCOUNT_ADDRESS=0x
# Agent (API) wallet private key. Mint one with `uv run python make_agent.py`.
# Signs orders, cannot move funds off the account. Treat as a secret anyway.
HL_AGENT_KEY=
# Only needed once, by approve_builder.py, to approve the Trench builder fee.
# An agent key cannot sign that approval. Remove the line again afterwards.
# HL_MASTER_KEY=

# ------------------------------------------------------------------- identity
# Kept out of config.toml so the config can be committed and shared. Each of
# these overrides the matching value in config.toml when set.
PERI_MODE=dry                 # dry | live. live places real orders.
HL_NETWORK=mainnet            # mainnet | testnet
TG_GROUP_ID=                  # numeric id of the group to read, e.g. -1001234567890
TG_CONTROL_USER=              # the ONLY Telegram user id allowed to issue slash commands
TG_CALLERS=                   # comma-separated handles to flag as trade callers
TG_NOTIFY_CHAT_ID=            # where alerts are sent

# ------------------------------------------------------------------- Telegram
# From https://my.telegram.org (API development tools). Used for the user login
# that reads the group; `uv run python fetch_messages.py` creates peri.session.
TG_API_ID=
TG_API_HASH=
# Bot token from @BotFather, for outbound alerts and slash commands.
TG_BOT_TOKEN=

# -------------------------------------------------------------------- analyst
# Any OpenAI-compatible chat endpoint. This is the brain: it makes every
# trading decision. Model choice matters more than any knob in config.toml.
ANALYST_API_KEY=
ANALYST_BASE_URL=https://api.example.com/v1
ANALYST_MODEL=
# Optional. Retries swap to this model rather than re-running the slow one.
ANALYST_FALLBACK_MODEL=

# -------------------------------------------------------------------- unused
# Reserved for web search in the analyst tool loop. Not required.
# TAVILY_API_KEY=
# EXA_API_KEY=
